[Unit]
Description=Telegram Kiro Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-kiro-bot
ExecStart=/opt/telegram-kiro-bot/venv/bin/python3 /opt/telegram-kiro-bot/telegram_kiro_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
